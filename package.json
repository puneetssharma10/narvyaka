{
  "name": "narvyaka",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Narvyaka — Because No Generation Should Start From Zero.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "pages:dev": "npm run build && wrangler pages dev dist --compatibility-date=2025-01-01 --d1=DB --r2=MEDIA --binding STUDIO_TOKEN=local-dev-token",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "db:local": "wrangler d1 execute narvyaka --local --file=./db/schema.sql",
    "db:remote": "wrangler d1 execute narvyaka --remote --file=./db/schema.sql",
    "studio:apply": "node scripts/apply-overrides.mjs",
    "studio:pull": "node scripts/pull-overrides.mjs"
  },
  "dependencies": {
    "@astrojs/react": "4.4.2",
    "@astrojs/sitemap": "3.7.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "5.18.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
