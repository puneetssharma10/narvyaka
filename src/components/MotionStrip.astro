---
/**
 * A quiet closing gesture: a single figure crossing the page, left to right,
 * on a loop — footsteps moving forward, echoing "no generation starts from
 * zero." The figure is an ordinary Studio-editable image (click it, upload a
 * replacement) so it can become a real photo, footprint icon or animation
 * frame without touching code.
 *
 * Respects prefers-reduced-motion: without it, the figure simply sits still,
 * centred — never a moving thing someone didn't ask for.
 */
interface Props {
  image: string
  alt: string
  editPath: string
  class?: string
}

const { image, alt, editPath, class: className = '' } = Astro.props
---

<div class={`nv-motion ${className}`} aria-hidden="true">
  <div class="nv-motion__figure" data-edit-image={editPath} data-edit-aspect="3:5">
    <img src={image} alt={alt} width="60" height="100" loading="lazy" />
  </div>
</div>

<style>
  .nv-motion {
    position: relative;
    height: 4.5rem;
    overflow: hidden;
  }

  .nv-motion__figure {
    position: absolute;
    top: 50%;
    left: -10%;
    width: 44px;
    height: 74px;
    transform: translateY(-50%);
    animation: nv-walk 14s linear infinite;
  }

  .nv-motion__figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @keyframes nv-walk {
    from {
      left: -8%;
    }
    to {
      left: 108%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nv-motion__figure {
      animation: none;
      left: 50%;
      transform: translate(-50%, -50%);
    }
  }
</style>
