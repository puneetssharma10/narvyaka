---
/**
 * An auto-cycling spotlight through a handful of existing pointers — built
 * from copy that already exists elsewhere on the site (the four Wisdom
 * Record parts, the three responsibility figures), not new content. One item
 * visible at a time, crossfading on an interval.
 *
 * Respects prefers-reduced-motion: without it, this is just the first item,
 * static — never a moving thing someone didn't ask for.
 */
import Icon from './Icon.astro'

interface ShowcaseItem {
  icon: 'voice' | 'note' | 'photo' | 'identity' | 'lock' | 'arrow' | 'quote'
  eyebrow: string
  title: string
  body: string
}

interface Props {
  items: ShowcaseItem[]
  class?: string
}

const { items, class: className = '' } = Astro.props
---

<div class={`nv-showcase relative overflow-hidden ${className}`} data-showcase>
  {
    items.map((item, i) => (
      <div class="nv-showcase__slide" data-showcase-slide aria-hidden={i === 0 ? 'false' : 'true'}>
        <span class="text-accent">
          <Icon name={item.icon} size={26} />
        </span>
        <p class="mt-5 text-[0.78rem] font-semibold uppercase tracking-[0.13em] text-signal">{item.eyebrow}</p>
        <h3 class="mt-2 font-heading text-[1.4rem]">{item.title}</h3>
        <p class="mt-3 max-w-[46ch] text-[0.98rem] leading-[1.6] text-muted">{item.body}</p>
      </div>
    ))
  }

  <div class="mt-8 flex gap-2" data-showcase-dots aria-hidden="true">
    {items.map((_, i) => <span class="nv-showcase__dot" data-index={i} />)}
  </div>
</div>

<style>
  .nv-showcase {
    min-height: 12rem;
  }

  .nv-showcase__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 480ms ease,
      transform 480ms ease;
    pointer-events: none;
  }

  .nv-showcase__slide[aria-hidden='false'] {
    position: relative;
    z-index: 1;
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .nv-showcase__dot {
    display: block;
    width: 20px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-hairline);
    transition: background-color 240ms ease;
  }

  .nv-showcase__dot[data-on] {
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .nv-showcase__slide {
      transition: none;
    }
  }
</style>

<script>
  // One instance per page today, but written to support more than one.
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-showcase-slide]'))
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.nv-showcase__dot'))
    if (slides.length < 2) return

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    dots[0]?.setAttribute('data-on', '')
    if (reduceMotion) return

    let current = 0
    let timer: number

    function show(next: number) {
      slides[current].setAttribute('aria-hidden', 'true')
      dots[current]?.removeAttribute('data-on')
      current = next
      slides[current].setAttribute('aria-hidden', 'false')
      dots[current]?.setAttribute('data-on', '')
    }

    function start() {
      timer = window.setInterval(() => show((current + 1) % slides.length), 4200)
    }

    function stop() {
      window.clearInterval(timer)
    }

    start()
    root.addEventListener('mouseenter', stop)
    root.addEventListener('mouseleave', start)
    root.addEventListener('focusin', stop)
    root.addEventListener('focusout', start)

    dots.forEach((dot, i) => {
      dot.style.cursor = 'pointer'
      dot.addEventListener('click', () => {
        stop()
        show(i)
        start()
      })
    })
  })
</script>
