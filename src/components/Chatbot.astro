---
/**
 * A static, no-AI help widget — a fixed decision tree over the ten questions
 * people actually ask, each with one honest, pre-written answer. Nothing here
 * calls a model or a server; every word is content from site.json, the same
 * as the rest of the site.
 */
import Icon from './Icon.astro'
import { content, editable, t } from '../lib/content'

const bot = content.chatbot
---

<div class="nv-chat" data-chatbot>
  <button
    type="button"
    class="nv-chat__launcher"
    data-chatbot-toggle
    aria-expanded="false"
    aria-controls="nv-chat-panel"
  >
    <Icon name="quote" size={20} />
    <span {...editable('chatbot.launcherLabel')}>{bot.launcherLabel}</span>
  </button>

  <div id="nv-chat-panel" class="nv-chat__panel" role="dialog" aria-label="Narvyaka help" hidden>
    <div class="nv-chat__head">
      <div>
        <p class="m-0 font-heading text-[1.05rem]">
          <span aria-hidden="true">{bot.greetingEmoji}</span>{' '}
          <span {...editable('chatbot.greetingWelcome')}>{bot.greetingWelcome}</span>
        </p>
        <p class="m-0 mt-1 text-[0.85rem] text-muted" {...editable('chatbot.greetingTagline')}>
          {bot.greetingTagline}
        </p>
      </div>
      <button type="button" class="nv-chat__close" data-chatbot-close aria-label="Close">
        ✕
      </button>
    </div>

    <div class="nv-chat__body">
      <div data-chatbot-menu>
        <p class="m-0 text-[0.92rem] font-medium" {...editable('chatbot.greetingPrompt')}>
          {bot.greetingPrompt}
        </p>
        <ol class="mt-3 grid list-none gap-1 p-0">
          {
            bot.options.map((option, i) => (
              <li>
                <button type="button" class="nv-chat__option" data-chatbot-option={i}>
                  <span class="tnum text-accent">{i + 1}.</span>{' '}
                  <span {...editable(`chatbot.options.${i}.label`)}>{option.label}</span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>

      {
        bot.options.map((option, i) => (
          <div data-chatbot-answer={i} hidden>
            <p class="m-0 font-heading text-[1.05rem]" {...editable(`chatbot.options.${i}.label`)}>
              {option.label}
            </p>
            <p class="mt-3 text-[0.94rem] leading-[1.6] text-ink/85" {...editable(`chatbot.options.${i}.answer`)}>
              {option.answer}
            </p>
            <a href={option.linkHref} class="mt-4 inline-flex items-center gap-2 text-[0.9rem] font-semibold text-accent">
              <span {...editable(`chatbot.options.${i}.linkLabel`)}>{option.linkLabel}</span>
              <Icon name="arrow" size={15} />
            </a>
            <button type="button" class="nv-chat__back" data-chatbot-back>
              ← <span {...editable('chatbot.backLabel')}>{t('chatbot.backLabel')}</span>
            </button>
          </div>
        ))
      }
    </div>

    <div class="nv-chat__foot">
      {
        bot.footerLinks.map((link, i) => (
          <a href={link.href} {...editable(`chatbot.footerLinks.${i}.label`)}>
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .nv-chat {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
  }

  .nv-chat__launcher {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-hairline);
    background: var(--color-surface);
    color: var(--color-ink);
    border-radius: 999px;
    padding: 0.65rem 1.1rem;
    font-size: 0.88rem;
    font-weight: 600;
    box-shadow: 0 8px 24px -8px rgba(11, 14, 20, 0.18);
    cursor: pointer;
    transition:
      transform 160ms ease,
      border-color 160ms ease;
  }

  .nv-chat__launcher:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .nv-chat__panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.75rem);
    width: min(23rem, calc(100vw - 2.5rem));
    max-height: min(32rem, calc(100vh - 8rem));
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card, 12px);
    box-shadow: 0 24px 48px -16px rgba(11, 14, 20, 0.28);
    overflow: hidden;
  }

  .nv-chat__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  .nv-chat__close {
    border: 0;
    background: none;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.2rem;
  }

  .nv-chat__close:hover {
    color: var(--color-ink);
  }

  .nv-chat__body {
    padding: 1.1rem;
    overflow-y: auto;
  }

  .nv-chat__option {
    display: block;
    width: 100%;
    text-align: left;
    border: 0;
    background: none;
    padding: 0.5rem 0.4rem;
    border-radius: 6px;
    font-size: 0.9rem;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 120ms ease;
  }

  .nv-chat__option:hover {
    background: var(--color-accent-soft);
  }

  .nv-chat__back {
    display: block;
    margin-top: 1.1rem;
    border: 0;
    background: none;
    color: var(--color-muted);
    font-size: 0.85rem;
    cursor: pointer;
    padding: 0;
  }

  .nv-chat__back:hover {
    color: var(--color-accent);
  }

  .nv-chat__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    padding: 0.75rem 1.1rem;
    border-top: 1px solid var(--color-hairline);
  }

  .nv-chat__foot a {
    font-size: 0.76rem;
    color: var(--color-muted);
    text-decoration: none;
  }

  .nv-chat__foot a:hover {
    color: var(--color-accent);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-chatbot]')
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-chatbot-toggle]')
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-chatbot-close]')
    const panel = root.querySelector<HTMLElement>('.nv-chat__panel')
    const menu = root.querySelector<HTMLElement>('[data-chatbot-menu]')
    const answers = Array.from(root.querySelectorAll<HTMLElement>('[data-chatbot-answer]'))
    const options = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-chatbot-option]'))
    const backs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-chatbot-back]'))

    function open() {
      panel?.removeAttribute('hidden')
      toggle?.setAttribute('aria-expanded', 'true')
    }

    function close() {
      panel?.setAttribute('hidden', '')
      toggle?.setAttribute('aria-expanded', 'false')
    }

    function showMenu() {
      menu?.removeAttribute('hidden')
      answers.forEach((a) => a.setAttribute('hidden', ''))
    }

    function showAnswer(index: number) {
      menu?.setAttribute('hidden', '')
      answers.forEach((a, i) => {
        if (i === index) a.removeAttribute('hidden')
        else a.setAttribute('hidden', '')
      })
    }

    toggle?.addEventListener('click', () => {
      if (panel?.hasAttribute('hidden')) open()
      else close()
    })
    closeBtn?.addEventListener('click', close)
    options.forEach((btn, i) => btn.addEventListener('click', () => showAnswer(i)))
    backs.forEach((btn) => btn.addEventListener('click', showMenu))

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel?.hasAttribute('hidden')) close()
    })
  }
</script>
