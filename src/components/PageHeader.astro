---
import { editable } from '../lib/content'

interface Props {
  eyebrow?: string
  eyebrowPath?: string
  heading: string
  headingPath?: string
  intro?: string
  introPath?: string
  /** Reading width for prose pages, wide for grids. */
  width?: 'read' | 'wide'
}

const { eyebrow, eyebrowPath, heading, headingPath, intro, introPath, width = 'read' } = Astro.props
const wrapClass = width === 'read' ? 'wrap-read' : 'wrap'
---

<header class="relative overflow-hidden border-b border-hairline pb-12 pt-16 md:pb-16 md:pt-24" data-spotlight>
  <div class="ambient-glow" aria-hidden="true"></div>
  <div class="grid-field-light absolute inset-0" aria-hidden="true"></div>
  <div class="hero-spotlight" aria-hidden="true"></div>
  <div class={`relative ${wrapClass}`}>
    {
      eyebrow && (
        <p
          class="eyebrow m-0"
          {...(eyebrowPath ? editable(eyebrowPath) : {})}
        >
          {eyebrow}
        </p>
      )
    }
    <h1 class="mt-5 max-w-[20ch]" {...(headingPath ? editable(headingPath) : {})}>{heading}</h1>
    {
      intro && (
        <p class="mt-7 max-w-[62ch] text-[1.06rem] leading-[1.7] text-muted" {...(introPath ? editable(introPath) : {})}>
          {intro}
        </p>
      )
    }
    <slot />
  </div>
</header>
