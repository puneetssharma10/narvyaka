---
import { editable } from '../lib/content'

interface Props {
  eyebrow?: string
  eyebrowPath?: string
  heading: string
  headingPath?: string
  intro?: string
  introPath?: string
  /** Reading width for prose pages, wide for grids. */
  width?: 'read' | 'wide'
}

const { eyebrow, eyebrowPath, heading, headingPath, intro, introPath, width = 'read' } = Astro.props
const wrapClass = width === 'read' ? 'wrap-read' : 'wrap'
---

<header class="border-b border-hairline pb-10 pt-14 md:pb-14 md:pt-20">
  <div class={wrapClass}>
    {
      eyebrow && (
        <p
          class="m-0 text-[0.82rem] font-semibold uppercase tracking-[0.11em] text-accent"
          {...(eyebrowPath ? editable(eyebrowPath) : {})}
        >
          {eyebrow}
        </p>
      )
    }
    <h1 class="mt-3 max-w-[20ch]" {...(headingPath ? editable(headingPath) : {})}>{heading}</h1>
    {
      intro && (
        <p class="mt-6 max-w-[62ch] text-[1.08rem] text-muted" {...(introPath ? editable(introPath) : {})}>
          {intro}
        </p>
      )
    }
    <slot />
  </div>
</header>
