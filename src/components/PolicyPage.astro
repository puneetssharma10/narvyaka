---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import PlaceholderNotice from '../components/PlaceholderNotice.astro'
import { editable } from '../lib/content'
import { siteConfig, hasEmail } from '../../site.config'

interface Section {
  title: string
  body: string
}

interface Props {
  /** Key in site.json — 'privacy' or 'terms'. */
  scope: string
  eyebrow: string
  heading: string
  isPlaceholder: boolean
  placeholderNotice: string
  lastUpdated: string
  sections: Section[]
}

const { scope, eyebrow, heading, isPlaceholder, placeholderNotice, lastUpdated, sections } = Astro.props
---

<Base title={heading} noindex={isPlaceholder}>
  <PageHeader eyebrow={eyebrow} eyebrowPath={`${scope}.eyebrow`} heading={heading} headingPath={`${scope}.heading`} />

  <section class="section">
    <div class="wrap-read">
      {
        isPlaceholder && (
          <PlaceholderNotice label="Not yet reviewed" class="mb-10">
            <span {...editable(`${scope}.placeholderNotice`)}>{placeholderNotice}</span>
          </PlaceholderNotice>
        )
      }

      <p class="text-[0.9rem] text-muted">
        {lastUpdated ? `Last updated ${lastUpdated}` : 'No revision date yet — this text has not been through legal review.'}
      </p>

      <div class="mt-10 grid gap-10">
        {
          sections.map((section, i) => (
            <section class="reveal">
              <h2 class="font-heading text-[1.4rem]" {...editable(`${scope}.sections.${i}.title`)}>
                {section.title}
              </h2>
              <p class="mt-3 leading-[1.75] text-ink/90" {...editable(`${scope}.sections.${i}.body`)}>
                {section.body}
              </p>
            </section>
          ))
        }
      </div>

      <hr class="hairline my-12" />

      <p class="text-[0.95rem] text-muted">
        {
          hasEmail ? (
            <>
              Questions about this page: <a href={`mailto:${siteConfig.contactEmail}`} class="text-accent">{siteConfig.contactEmail}</a>
            </>
          ) : (
            <>
              A contact address will be published here before any record is made public. Until then, reach us through the{' '}
              <a href="/volunteer" class="text-accent">volunteer page</a>.
            </>
          )
        }
      </p>
    </div>
  </section>
</Base>
