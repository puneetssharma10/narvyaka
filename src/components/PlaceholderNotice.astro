---
/**
 * An honest label for content that is not final.
 *
 * Build Brief §7: placeholder content must be *clearly labelled as such in the
 * UI*. This is the one component allowed to be visually loud, because a
 * quiet placeholder is how a placeholder ends up shipping as if it were real.
 */
interface Props {
  /** Short word shown in the chip: "Example", "Placeholder", "Draft". */
  label?: string
  class?: string
}

const { label = 'Placeholder', class: className = '' } = Astro.props
---

<aside
  class={`nv-note rounded-[6px] border border-dashed border-caution/55 bg-caution/8 p-4 ${className}`}
  role="note"
>
  <!-- Colour comes from .nv-note__text, not a utility, so the .carbon variant
       can override it without fighting utility-layer precedence. -->
  <p class="nv-note__text m-0 flex flex-wrap items-baseline gap-x-2.5 gap-y-1 text-[0.875rem] leading-relaxed">
    <span
      class="rounded-[3px] bg-caution px-2 py-0.5 text-[0.68rem] font-bold uppercase tracking-[0.12em] text-carbon"
      >{label}</span
    >
    <span><slot /></span>
  </p>
</aside>
