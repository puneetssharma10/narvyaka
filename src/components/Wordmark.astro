---
/**
 * The Narvyaka lockup: the logomark, then the name.
 *
 * Three states, in priority order:
 *   1. A custom logo file (Studio → Logo, or theme.logo.src) replaces the
 *      whole lockup — that file is assumed to be a complete lockup itself.
 *   2. Otherwise the built-in LogoMark plus the name in Space Grotesk.
 *   3. `markOnly` renders just the mark, for tight spaces.
 *
 * Dropping a real logo in later needs no component changes anywhere.
 */
import LogoMark from './LogoMark.astro'
import { content } from '../lib/content'

interface Props {
  /** Rendered size of the lockup. */
  size?: 'sm' | 'md' | 'lg' | 'xl'
  class?: string
  /** Marks this as the element the Studio's logo drop-zone targets. */
  logoSlot?: boolean
  /** Hide the name, keep the mark. */
  markOnly?: boolean
}

const { size = 'md', class: className = '', logoSlot: isSlot = true, markOnly = false } = Astro.props

const logo = content.theme.logo

const scale: Record<string, { text: string; mark: number; gap: string }> = {
  sm: { text: 'text-[0.9rem]', mark: 20, gap: 'gap-2' },
  md: { text: 'text-[1.05rem]', mark: 26, gap: 'gap-2.5' },
  lg: { text: 'text-[1.5rem]', mark: 34, gap: 'gap-3' },
  xl: { text: 'text-[clamp(1.75rem,4.2vw,2.8rem)]', mark: 58, gap: 'gap-4' },
}

const s = scale[size]
---

<span
  class={`inline-flex items-center ${s.gap} leading-none ${className}`}
  data-logo-slot={isSlot ? '' : undefined}
>
  {
    logo.src ? (
      <img
        src={logo.src}
        alt={logo.alt}
        height={logo.height}
        style={`height:${logo.height}px;width:auto`}
        class="block"
        data-logo-img
      />
    ) : (
      <>
        <LogoMark size={s.mark} class="shrink-0" />
        {!markOnly && (
          <span class={`wordmark ${s.text}`} data-logo-text>
            Narvyaka
          </span>
        )}
      </>
    )
  }
</span>
