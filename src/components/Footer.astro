---
import Wordmark from './Wordmark.astro'
import { content, editable, t } from '../lib/content'
import { siteConfig, hasEmail, activeSocials } from '../../site.config'

const year = new Date().getFullYear()
const yearLabel = year > siteConfig.foundedYear ? `${siteConfig.foundedYear}–${year}` : String(siteConfig.foundedYear)

const socialLabels: Record<string, string> = {
  github: 'GitHub',
  instagram: 'Instagram',
  youtube: 'YouTube',
  linkedin: 'LinkedIn',
  x: 'X',
}
---

<footer class="carbon mt-auto">
  <div class="wrap py-14 md:py-20">
    <div class="grid gap-12 md:grid-cols-[minmax(0,1.3fr)_repeat(3,minmax(0,1fr))]">
      <div class="max-w-sm">
        <Wordmark size="md" logoSlot={false} class="text-white" />
        <p class="mt-4 text-[0.93rem] leading-[1.65] text-white/55" {...editable('footer.blurb')}>
          {t('footer.blurb')}
        </p>
        <p
          class="mt-6 font-heading text-[1.05rem] tracking-tight text-white"
          {...editable('footer.philosophy')}
        >
          {t('footer.philosophy')}
        </p>
      </div>

      {
        content.footer.columns.map((column, ci) => (
          <div>
            <h2
              class="font-body text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-white/40"
              {...editable(`footer.columns.${ci}.title`)}
            >
              {column.title}
            </h2>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link, li) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[0.93rem] text-white/75 no-underline transition-colors hover:text-white"
                    {...editable(`footer.columns.${ci}.links.${li}.label`)}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <hr class="my-12 border-0 border-t border-white/12" />

    <div class="flex flex-col gap-4 text-[0.8rem] text-white/40 sm:flex-row sm:items-center sm:justify-between">
      <p>© {yearLabel} {siteConfig.legalEntity}</p>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {
          hasEmail && (
            <a href={`mailto:${siteConfig.contactEmail}`} class="text-white/50 no-underline hover:text-white">
              {t('footer.emailLabel')}
            </a>
          )
        }
        {
          activeSocials.map((social) => (
            <a
              href={social.url}
              rel="me noopener"
              target="_blank"
              class="text-white/50 no-underline hover:text-white"
            >
              {socialLabels[social.key] ?? social.key}
            </a>
          ))
        }
        <a href="/studio" class="text-white/50 no-underline hover:text-white">Studio</a>
      </div>
    </div>
  </div>
</footer>
