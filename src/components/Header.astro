---
import Wordmark from './Wordmark.astro'
import { content, editable, t } from '../lib/content'

const navItems = content.nav.items
const cta = content.nav.cta
const path = Astro.url.pathname
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href))
---

<header class="sticky top-0 z-40 border-b border-hairline bg-bg/80 backdrop-blur-md">
  <div class="wrap flex h-[68px] items-center justify-between gap-4">
    <a href="/" class="shrink-0 text-ink no-underline" aria-label="Narvyaka — home">
      <Wordmark size="md" />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {
        navItems.map((item, i) => (
          <a
            href={item.href}
            class={`text-[0.78rem] font-semibold uppercase tracking-[0.12em] no-underline transition-colors hover:text-accent ${
              isActive(item.href) ? 'text-accent' : 'text-muted'
            }`}
            aria-current={isActive(item.href) ? 'page' : undefined}
            {...editable(`nav.items.${i}.label`)}
          >
            {item.label}
          </a>
        ))
      }
      <a href={cta.href} class="btn btn-primary px-4 py-2.5 text-[0.78rem] uppercase tracking-[0.1em]" {...editable('nav.cta.label')}>
        {cta.label}
      </a>
    </nav>

    <button
      type="button"
      class="btn btn-secondary px-3 py-2 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
        <path d="M0 1h18M0 7h18M0 13h18" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-hairline bg-bg md:hidden" aria-label="Main" data-nav-panel>
    <div class="wrap flex flex-col gap-1 py-4">
      {
        navItems.map((item) => (
          <a href={item.href} class="rounded-[4px] px-2 py-2.5 text-[0.85rem] font-semibold uppercase tracking-[0.1em] text-ink no-underline hover:bg-accent-soft">
            {item.label}
          </a>
        ))
      }
      <a href={cta.href} class="btn btn-primary mt-2">{t('nav.cta.label')}</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]')
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]')

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true'
    toggle.setAttribute('aria-expanded', String(!open))
    panel?.classList.toggle('hidden', open)
  })
</script>
