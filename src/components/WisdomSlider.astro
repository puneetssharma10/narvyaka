---
/**
 * A full-width image carousel of short, secular "wisdom" thoughts — the
 * first thing a visitor scrolls into after the hero. Each slide's picture is
 * an ordinary Studio-editable image (click it, upload a replacement; the
 * cropper opens first, same as any other photo on the site) so the whole
 * set can be swapped for real photographs without touching code.
 *
 * Deliberately free of any mythological or religious reference — this is
 * the first content a visitor sees, and it should read as universal.
 */
import Icon from './Icon.astro'

interface Slide {
  image: string
  quote: string
}

interface Props {
  items: Slide[]
  basePath: string
  class?: string
}

const { items, basePath, class: className = '' } = Astro.props
---

<div class={`nv-wisdom relative overflow-hidden ${className}`} data-wisdom-slider>
  {
    items.map((slide, i) => (
      <div class="nv-wisdom__slide" data-wisdom-slide aria-hidden={i === 0 ? 'false' : 'true'}>
        <div
          class="nv-wisdom__image"
          data-edit-image={`${basePath}.${i}.image`}
          data-edit-aspect="16:9"
        >
          <img
            src={slide.image}
            alt=""
            class="h-full w-full object-cover"
            width="960"
            height="540"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </div>
        <div class="nv-wisdom__scrim" aria-hidden="true" />
        <blockquote class="nv-wisdom__quote">
          <span data-edit={`${basePath}.${i}.quote`}>{slide.quote}</span>
        </blockquote>
      </div>
    ))
  }

  <button type="button" class="nv-wisdom__arrow nv-wisdom__arrow--prev" data-wisdom-prev aria-label="Previous thought">
    <Icon name="arrow" size={18} class="rotate-180" />
  </button>
  <button type="button" class="nv-wisdom__arrow nv-wisdom__arrow--next" data-wisdom-next aria-label="Next thought">
    <Icon name="arrow" size={18} />
  </button>

  <div class="nv-wisdom__dots" data-wisdom-dots aria-hidden="true">
    {items.map((_, i) => <span class="nv-wisdom__dot" data-index={i} />)}
  </div>
</div>

<style>
  .nv-wisdom {
    aspect-ratio: 16 / 9;
    max-height: min(72vh, 620px);
    border-radius: 6px;
    background: var(--color-carbon);
  }

  .nv-wisdom__slide {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    transition: opacity 620ms ease;
    pointer-events: none;
  }

  .nv-wisdom__slide[aria-hidden='false'] {
    z-index: 1;
    opacity: 1;
    pointer-events: auto;
  }

  .nv-wisdom__image {
    position: absolute;
    inset: 0;
  }

  .nv-wisdom__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(11, 14, 20, 0.82) 0%, rgba(11, 14, 20, 0.15) 46%, rgba(11, 14, 20, 0.05) 100%);
  }

  .nv-wisdom__quote {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 2.75rem clamp(1.25rem, 4vw, 3rem) 3.5rem;
    max-width: 46ch;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.6vw, 1.65rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: #fff;
  }

  .nv-wisdom__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(11, 14, 20, 0.35);
    color: #fff;
    transform: translateY(-50%);
    transition:
      background-color 200ms ease,
      opacity 200ms ease;
    cursor: pointer;
  }

  .nv-wisdom__arrow:hover {
    background: rgba(11, 14, 20, 0.6);
  }

  .nv-wisdom__arrow--prev {
    left: 1rem;
  }

  .nv-wisdom__arrow--next {
    right: 1rem;
  }

  .nv-wisdom__dots {
    position: absolute;
    right: clamp(1.25rem, 4vw, 3rem);
    bottom: 1.5rem;
    z-index: 2;
    display: flex;
    gap: 0.4rem;
  }

  .nv-wisdom__dot {
    display: block;
    width: 18px;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.32);
    cursor: pointer;
    transition: background-color 240ms ease;
  }

  .nv-wisdom__dot[data-on] {
    background: #fff;
  }

  @media (max-width: 640px) {
    .nv-wisdom__arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nv-wisdom__slide {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-wisdom-slider]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-wisdom-slide]'))
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.nv-wisdom__dot'))
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-wisdom-prev]')
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-wisdom-next]')
    if (slides.length < 2) {
      prevBtn?.remove()
      nextBtn?.remove()
      return
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    dots[0]?.setAttribute('data-on', '')

    let current = 0
    let timer: number

    function show(next: number) {
      slides[current].setAttribute('aria-hidden', 'true')
      dots[current]?.removeAttribute('data-on')
      current = (next + slides.length) % slides.length
      slides[current].setAttribute('aria-hidden', 'false')
      dots[current]?.setAttribute('data-on', '')
    }

    function start() {
      if (reduceMotion) return
      timer = window.setInterval(() => show(current + 1), 5200)
    }

    function stop() {
      window.clearInterval(timer)
    }

    start()
    root.addEventListener('mouseenter', stop)
    root.addEventListener('mouseleave', start)
    root.addEventListener('focusin', stop)
    root.addEventListener('focusout', start)

    prevBtn?.addEventListener('click', () => {
      stop()
      show(current - 1)
      start()
    })
    nextBtn?.addEventListener('click', () => {
      stop()
      show(current + 1)
      start()
    })
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        stop()
        show(i)
        start()
      })
    })
  })
</script>
