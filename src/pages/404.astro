---
import Base from '../layouts/Base.astro'
---

<Base title="Page not found" noindex>
  <section class="section-lg">
    <div class="wrap-read text-center">
      <p class="m-0 text-[0.82rem] font-semibold uppercase tracking-[0.11em] text-accent">404</p>
      <h1 class="mx-auto mt-4 max-w-[18ch]">This page isn't here.</h1>
      <p class="mx-auto mt-5 max-w-[46ch] text-muted">
        Either it moved, or it never existed. Neither is your fault.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">Back to the homepage</a>
        <a href="/browse" class="btn btn-secondary">Browse the archive</a>
      </div>
    </div>
  </section>
</Base>
