---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import Icon from '../components/Icon.astro'
import VolunteerForm from '../components/forms/VolunteerForm'
import { content, editable, t } from '../lib/content'
import { siteConfig } from '../../site.config'

const v = content.volunteer
// Only the two open positions are selectable — we do not collect applications
// for roles that have no work attached to them yet.
const roleNames = v.openings.map((opening) => opening.title)
---

<Base title="Become a founding volunteer" description={v.intro}>
  <PageHeader
    eyebrow={v.eyebrow}
    eyebrowPath="volunteer.eyebrow"
    heading={v.heading}
    headingPath="volunteer.heading"
    intro={v.intro}
    introPath="volunteer.intro"
  />

  <!-- ── The two openings ──────────────────────────────────────────────── -->
  <section class="section border-b border-hairline">
    <div class="wrap">
      <div class="max-w-[54ch]">
        <span class="light-bar mb-6"></span>
        <h2 {...editable('volunteer.rolesHeading')}>{t('volunteer.rolesHeading')}</h2>
        <p class="mt-5 text-muted" {...editable('volunteer.rolesIntro')}>{t('volunteer.rolesIntro')}</p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {
          v.openings.map((opening, i) => (
            <article class="card reveal flex flex-col p-7 md:p-9" style={`transition-delay:${i * 70}ms`}>
              <div class="flex items-baseline gap-4">
                <span class="font-heading text-[2.4rem] leading-none tracking-tight text-accent/25 tnum">
                  {opening.count}
                </span>
                <h3
                  class="font-heading text-[1.5rem] tracking-tight"
                  {...editable(`volunteer.openings.${i}.title`)}
                >
                  {opening.title}
                </h3>
              </div>

              <p
                class="mt-5 leading-[1.7] text-ink/85"
                {...editable(`volunteer.openings.${i}.body`)}
              >
                {opening.body}
              </p>

              <ul class="mt-6 grid list-none gap-3 border-t border-hairline p-0 pt-6">
                {opening.asks.map((ask, j) => (
                  <li class="flex items-start gap-3 text-[0.95rem] leading-[1.55] text-muted">
                    <span class="mt-[0.55rem] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                    <span {...editable(`volunteer.openings.${i}.asks.${j}`)}>{ask}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── What we ask ───────────────────────────────────────────────────── -->
  <section class="section border-b border-hairline">
    <div class="wrap-read reveal">
      <span class="light-bar mb-6"></span>
      <h2 {...editable('volunteer.expectationsHeading')}>{t('volunteer.expectationsHeading')}</h2>
      <ul class="mt-8 grid list-none gap-5 p-0">
        {
          v.expectations.map((item, i) => (
            <li class="flex gap-4">
              <span class="mt-1 font-heading text-[0.8rem] tabular-nums text-accent">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-[1.02rem] leading-[1.65]" {...editable(`volunteer.expectations.${i}`)}>
                {item}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── The founding commitment ───────────────────────────────────────── -->
  <section class="section border-b border-hairline">
    <div class="wrap-read reveal text-center">
      <p class="eyebrow" {...editable('volunteer.commitmentHeading')}>{t('volunteer.commitmentHeading')}</p>
      <blockquote
        class="mx-auto mt-6 max-w-[26ch] font-heading text-[clamp(1.4rem,3.6vw,2rem)] leading-[1.25] tracking-tight"
        {...editable('volunteer.commitment')}
      >
        “{t('volunteer.commitment')}”
      </blockquote>
      <p class="mx-auto mt-7 max-w-[52ch] leading-[1.7] text-muted" {...editable('volunteer.commitmentNote')}>
        {t('volunteer.commitmentNote')}
      </p>
    </div>
  </section>

  <!-- ── Roles that are not open yet ───────────────────────────────────── -->
  <section class="section border-b border-hairline">
    <div class="wrap-read reveal">
      <h2 class="font-heading text-[1.3rem] text-muted" {...editable('volunteer.laterHeading')}>
        {t('volunteer.laterHeading')}
      </h2>
      <p class="mt-3 text-[0.98rem] text-muted" {...editable('volunteer.laterIntro')}>
        {t('volunteer.laterIntro')}
      </p>
      <ul class="mt-6 flex list-none flex-wrap gap-2 p-0">
        {
          v.laterRoles.map((role, i) => (
            <li
              class="rounded-[3px] border border-hairline px-3 py-1.5 text-[0.8rem] font-medium uppercase tracking-[0.1em] text-muted"
              {...editable(`volunteer.laterRoles.${i}`)}
            >
              {role}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── The Pledge ────────────────────────────────────────────────────── -->
  <section class="section border-b border-hairline">
    <div class="wrap-read reveal">
      <span class="light-bar mb-6"></span>
      <h2 {...editable('volunteer.pledgeHeading')}>{t('volunteer.pledgeHeading')}</h2>
      <ul class="mt-8 grid list-none gap-4 p-0">
        {
          v.pledge.map((line, i) => (
            <li class="flex items-start gap-4 border-b border-hairline pb-4 last:border-0">
              <Icon name="check" size={17} class="mt-1 shrink-0 text-accent" />
              <span class="text-[1.02rem] leading-[1.6]" {...editable(`volunteer.pledge.${i}`)}>
                {line}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Application ───────────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap-read">
      <span class="light-bar mb-6"></span>
      <h2 {...editable('volunteer.formHeading')}>{t('volunteer.formHeading')}</h2>
      <p class="mb-10 mt-5 text-muted" {...editable('volunteer.formIntro')}>{t('volunteer.formIntro')}</p>

      <VolunteerForm
        client:load
        copy={content.forms.volunteerForm}
        common={content.forms.common}
        roles={roleNames}
        endpoint={siteConfig.api.volunteers}
        afterSubmit={v.afterSubmit}
      />
    </div>
  </section>
</Base>
