---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import Icon from '../components/Icon.astro'
import IntakeForm from '../components/forms/IntakeForm'
import { content, editable, t } from '../lib/content'
import { siteConfig } from '../../site.config'

const r = content.recordSomeone
const forms = content.forms

const copy = {
  common: forms.common,
  steps: forms.steps,
  consent: forms.consent,
  about: forms.about,
  record: forms.record,
  lineage: forms.lineage,
  photos: forms.photos,
  review: forms.review,
  onBehalf: forms.onBehalf,
  afterSubmit: content.preserve.afterSubmit,
}
---

<Base title="Record someone you know" description={r.intro}>
  <PageHeader
    eyebrow={r.eyebrow}
    eyebrowPath="recordSomeone.eyebrow"
    heading={r.heading}
    headingPath="recordSomeone.heading"
    intro={r.intro}
    introPath="recordSomeone.intro"
  />

  <!-- ── Who ───────────────────────────────────────────────────────────── -->
  <section class="section border-b border-hairline">
    <!-- Stacked rather than a two-column split, but held to the reading
         measure: full `wrap` width would run these lines past 120 characters. -->
    <div class="wrap-read grid gap-12">
      <div class="reveal">
        <h2 {...editable('recordSomeone.whoHeading')}>{t('recordSomeone.whoHeading')}</h2>
        <ul class="mt-6 grid list-none gap-3 p-0">
          {
            r.who.map((item, i) => (
              <li class="flex items-start gap-3">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/50" aria-hidden="true" />
                <span class="text-[1.02rem] leading-[1.6]" {...editable(`recordSomeone.who.${i}`)}>
                  {item}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal">
        <h2 {...editable('recordSomeone.howHeading')}>{t('recordSomeone.howHeading')}</h2>
        <div class="mt-6 grid gap-5">
          {
            r.how.map((item, i) => (
              <div class="card p-5">
                <h3 class="font-heading text-[1.08rem]" {...editable(`recordSomeone.how.${i}.title`)}>
                  {item.title}
                </h3>
                <p class="mt-1.5 text-[0.95rem] leading-[1.6] text-muted" {...editable(`recordSomeone.how.${i}.body`)}>
                  {item.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ── The one question ──────────────────────────────────────────────── -->
  <section class="section border-b border-hairline">
    <div class="wrap-read reveal text-center">
      <p class="eyebrow" {...editable('recordSomeone.askHeading')}>{t('recordSomeone.askHeading')}</p>
      <blockquote
        class="mx-auto mt-6 max-w-[24ch] font-heading text-[clamp(1.5rem,4vw,2.2rem)] leading-[1.25] tracking-tight"
        {...editable('recordSomeone.askQuestion')}
      >
        “{t('recordSomeone.askQuestion')}”
      </blockquote>
      <span class="light-bar mx-auto my-9"></span>
      <p class="mx-auto max-w-[54ch] leading-[1.7] text-muted" {...editable('recordSomeone.askNote')}>
        {t('recordSomeone.askNote')}
      </p>
    </div>
  </section>

  <!-- ── Consent first ─────────────────────────────────────────────────── -->
  <section class="section border-b border-hairline">
    <div class="wrap-read reveal">
      <div class="card flex flex-col gap-4 p-6 sm:flex-row sm:gap-6 md:p-8">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-accent-soft text-accent-hover">
          <Icon name="lock" size={20} />
        </span>
        <div>
          <h2 class="font-heading text-[1.35rem]" {...editable('recordSomeone.consentHeading')}>
            {t('recordSomeone.consentHeading')}
          </h2>
          <p class="mt-3 leading-[1.7] text-ink/90" {...editable('recordSomeone.consentBody')}>
            {t('recordSomeone.consentBody')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── The form, filled in on their behalf ───────────────────────────── -->
  <section class="section">
    <div class="wrap-read">
      <h2 class="mb-9" {...editable('recordSomeone.formHeading')}>{t('recordSomeone.formHeading')}</h2>

      <IntakeForm
        client:load
        mode="on_behalf"
        copy={copy}
        endpoints={{ submissions: siteConfig.api.submissions, uploads: siteConfig.api.uploads }}
        storageKey="narvyaka.draft.record-someone.v1"
      />
    </div>
  </section>
</Base>
