---
import PolicyPage from '../components/PolicyPage.astro'
import { content } from '../lib/content'

const p = content.privacy
---

<PolicyPage
  scope="privacy"
  eyebrow={p.eyebrow}
  heading={p.heading}
  isPlaceholder={p.isPlaceholder}
  placeholderNotice={p.placeholderNotice}
  lastUpdated={p.lastUpdated}
  sections={p.sections}
/>
