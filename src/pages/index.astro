---
import Base from '../layouts/Base.astro'
import Wordmark from '../components/Wordmark.astro'
import Icon from '../components/Icon.astro'
import AudioPlayer from '../components/AudioPlayer.astro'
import PlaceholderNotice from '../components/PlaceholderNotice.astro'
import WisdomSlider from '../components/WisdomSlider.astro'
import MotionStrip from '../components/MotionStrip.astro'
import CapsulePhotoRotator from '../components/CapsulePhotoRotator.astro'
import { content, editable, t, list } from '../lib/content'
import { siteConfig } from '../../site.config'

const home = content.home
const example = home.exampleCapsule
const problemParagraphs = list<string>('home.problem.paragraphs')
const iconFor = { voice: 'voice', note: 'note', photo: 'photo', identity: 'identity' } as const
const wisdomSlides = home.wisdomSlider.slides
const motion = content.motion
---

<Base title={siteConfig.name}>
  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden border-b border-hairline bg-surface" data-spotlight>
    <!-- Two soft colour blobs, drifting slowly — the premium, "alive"
         background layer. Idle motion only, never tied to scroll. -->
    <div class="ambient-glow" aria-hidden="true"></div>
    <!-- The faintest technical grid, masked so it fades before the copy. -->
    <div class="grid-field-light absolute inset-0" aria-hidden="true"></div>
    <!-- A soft highlight that follows the pointer on desktop. -->
    <div class="hero-spotlight" aria-hidden="true"></div>
    <!-- Light signature: the logo's own brown-gold-to-blue sweep, slowly
         travelling across the top edge rather than sitting still. -->
    <div class="light-signature absolute inset-x-0 top-0 h-[3px]" aria-hidden="true"></div>

    <!-- Single column, top to bottom, on every screen size — the same flow
         mobile always had, now kept at every width instead of only switching
         to a side-by-side split once the viewport widens.

         The measures below only ever widen at md/lg/xl. A phone viewport is
         narrower than even the smallest of them, so the mobile rendering is
         untouched. The headline/subhead/intro each cap their own line length
         in characters (below), independent of this container, so widening
         it doesn't run those lines long — the extra width is spent on the
         capsule photo card, which is the point: more room for the image. -->
    <div class="wrap relative section-lg">
      <div class="mx-auto flex max-w-xl flex-col items-center text-center md:max-w-2xl lg:max-w-4xl xl:max-w-5xl">
        <Wordmark size="lg" class="block" />

        <h1 class="mt-8 max-w-[16ch] md:max-w-[24ch]" data-type-target {...editable('home.hero.tagline')}>
          {t('home.hero.tagline')}
        </h1>

        <p
          class="mt-8 max-w-[24ch] font-heading text-[clamp(1.3rem,2.6vw,1.75rem)] font-normal leading-[1.25] tracking-tight text-accent md:max-w-[36ch]"
          {...editable('home.hero.subhead')}
        >
          {t('home.hero.subhead')}
        </p>

        <p
          class="mt-7 max-w-[52ch] text-[1.05rem] leading-[1.7] text-muted md:max-w-[64ch]"
          {...editable('home.hero.intro')}
        >
          {t('home.hero.intro')}
        </p>

        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a href={home.hero.primaryCta.href} class="btn btn-primary" {...editable('home.hero.primaryCta.label')}>
            {home.hero.primaryCta.label}
            <Icon name="arrow" size={16} />
          </a>
          <a
            href={home.hero.secondaryCta.href}
            class="btn btn-secondary"
            {...editable('home.hero.secondaryCta.label')}
          >
            {home.hero.secondaryCta.label}
          </a>
        </div>

        <!-- The embedded playable capsule, stacked below the copy rather than
             beside it. Clearly marked as an example until a real recording
             exists — we do not invent a contributor. -->
        <div class="card mt-14 w-full overflow-hidden text-left shadow-[0_1px_2px_rgba(11,14,20,0.04),0_12px_32px_-12px_rgba(11,14,20,0.10)]">
          <div class="flex items-center justify-between gap-3 border-b border-hairline px-5 py-3.5">
            <span
              class="rounded-[5px] bg-signal px-2 py-0.5 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-white"
              {...editable('home.exampleCapsule.badge')}
            >
              {example.badge}
            </span>
            <span
              class="text-[0.75rem] uppercase tracking-[0.1em] text-muted"
              {...editable('home.exampleCapsule.context')}
            >
              {example.context}
            </span>
          </div>

          <CapsulePhotoRotator
            items={example.photos}
            basePath="home.exampleCapsule.photos"
            alt={example.photoCaption}
            rotationSeconds={example.rotationSeconds}
            timingPath="home.exampleCapsule.rotationSeconds"
            class="aspect-[4/3] w-full"
          />

          <div class="space-y-5 p-6">
            <blockquote
              class="m-0 font-heading text-[1.35rem] font-medium leading-[1.3] tracking-tight"
              {...editable('home.exampleCapsule.lesson')}
            >
              “{example.lesson}”
            </blockquote>

            <AudioPlayer
              src={example.audioSrc}
              missingLabel={example.audioMissingLabel}
              duration={example.durationLabel}
            />

            <p
              class="m-0 text-[0.8rem] uppercase tracking-[0.1em] text-muted"
              {...editable('home.exampleCapsule.attribution')}
            >
              {example.attribution}
            </p>

            <PlaceholderNotice label="Example">
              <span {...editable('home.exampleCapsule.note')}>{example.note}</span>
            </PlaceholderNotice>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Nine short thoughts on wisdom ────────────────────────────────────
       A slow image carousel, deliberately free of any mythological or
       religious reference since this is the first content after the hero.
       Every picture is a plain Studio-editable image — click it, upload a
       replacement — so the whole set can become real photographs later. -->
  <section class="section border-b border-hairline">
    <div class="wrap reveal">
      <span class="light-bar mb-7"></span>
      <WisdomSlider
        items={wisdomSlides}
        basePath="home.wisdomSlider.slides"
        rotationSeconds={home.wisdomSlider.rotationSeconds}
        timingPath="home.wisdomSlider.rotationSeconds"
      />
    </div>
  </section>

  <!-- ── The problem ───────────────────────────────────────────────────── -->
  <section class="section border-b border-hairline">
    <div class="wrap-read reveal">
      <span class="light-bar mb-7"></span>
      <h2 {...editable('home.problem.heading')}>{t('home.problem.heading')}</h2>
      <div class="prose-narvyaka mt-7">
        {
          problemParagraphs.map((paragraph, i) => (
            <p {...editable(`home.problem.paragraphs.${i}`)}>{paragraph}</p>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Phase one, stated plainly ─────────────────────────────────────── -->
  <section class="section border-b border-hairline">
    <div class="wrap">
      <div class="max-w-[56ch] reveal">
        <p class="eyebrow" {...editable('home.status.eyebrow')}>{t('home.status.eyebrow')}</p>
        <h2 class="mt-4" {...editable('home.status.heading')}>{t('home.status.heading')}</h2>
        <p class="mt-5 text-muted" {...editable('home.status.body')}>{t('home.status.body')}</p>
      </div>

      <dl class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-3">
        {
          home.status.metrics.map((metric, i) => (
            <div
              class={`reveal ${i > 0 ? 'sm:border-l sm:border-hairline sm:pl-12' : ''}`}
              style={`transition-delay:${i * 60}ms`}
            >
              <dd class="m-0 flex items-baseline gap-1.5">
                <span class="font-heading text-[3rem] font-semibold leading-none tracking-tight tnum">
                  {metric.value}
                </span>
                <span class="font-heading text-[1.4rem] leading-none tracking-tight text-muted/60 tnum">
                  / {metric.target}
                </span>
              </dd>
              <dt
                class="mt-4 text-[0.78rem] font-semibold uppercase tracking-[0.13em]"
                {...editable(`home.status.metrics.${i}.label`)}
              >
                {metric.label}
              </dt>
              <p class="mt-1.5 text-[0.88rem] text-muted" {...editable(`home.status.metrics.${i}.note`)}>
                {metric.note}
              </p>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ── Three ways in ─────────────────────────────────────────────────── -->
  <section class="section border-b border-hairline">
    <div class="wrap">
      <div class="reveal">
        <span class="light-bar mb-7"></span>
        <h2 {...editable('home.ctas.heading')}>{t('home.ctas.heading')}</h2>
      </div>

      <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-x-12 md:gap-y-0">
        {
          home.ctas.items.map((item, i) => (
            <a
              href={item.href}
              class={`reveal group relative flex flex-col border-t-2 border-hairline pt-6 no-underline transition-colors hover:border-accent ${i > 0 ? 'md:border-l md:pl-10' : ''}`}
              style={`transition-delay:${i * 60}ms`}
            >
              <span class="font-heading text-[0.8rem] tabular-nums text-accent">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-4 font-heading text-[1.35rem]" {...editable(`home.ctas.items.${i}.title`)}>
                {item.title}
              </h3>
              <p class="mt-3 flex-1 text-[0.98rem] leading-[1.6] text-muted" {...editable(`home.ctas.items.${i}.body`)}>
                {item.body}
              </p>
              <span class="mt-7 inline-flex items-center gap-2 text-[0.9rem] font-semibold text-accent">
                <span {...editable(`home.ctas.items.${i}.action`)}>{item.action}</span>
                <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── The four parts ────────────────────────────────────────────────── -->
  <section class="section border-b border-hairline">
    <div class="wrap">
      <div class="max-w-[52ch] reveal">
        <span class="light-bar mb-7"></span>
        <h2 {...editable('home.howItWorks.heading')}>{t('home.howItWorks.heading')}</h2>
        <p class="mt-5 text-muted" {...editable('home.howItWorks.intro')}>{t('home.howItWorks.intro')}</p>
      </div>

      <ol class="mt-12 grid list-none gap-x-6 gap-y-10 p-0 sm:grid-cols-2 lg:grid-cols-4">
        {
          home.howItWorks.items.map((item, i) => (
            <li class="reveal border-t border-hairline pt-6" style={`transition-delay:${i * 60}ms`}>
              <span class="text-accent">
                <Icon name={iconFor[item.icon as keyof typeof iconFor] ?? 'note'} size={22} />
              </span>
              <h3 class="mt-5 font-heading text-[1.15rem]" {...editable(`home.howItWorks.items.${i}.title`)}>
                {item.title}
              </h3>
              <p class="mt-2.5 text-[0.94rem] leading-[1.6] text-muted" {...editable(`home.howItWorks.items.${i}.body`)}>
                {item.body}
              </p>
            </li>
          ))
        }
      </ol>

      <a
        href={home.howItWorks.link.href}
        class="mt-12 inline-flex items-center gap-2 text-[0.9rem] font-semibold text-accent"
      >
        <span {...editable('home.howItWorks.link.label')}>{home.howItWorks.link.label}</span>
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>

  <!-- ── Founder line ──────────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap-read reveal">
      <figure class="m-0 flex flex-col items-start gap-7 sm:flex-row sm:items-center">
        <div
          class="h-20 w-20 shrink-0 overflow-hidden rounded-[6px] bg-accent-soft"
          {...{ 'data-edit-image': 'home.founderLine.photo', 'data-edit-aspect': '1:1' }}
        >
          <img
            src={home.founderLine.photo || '/placeholder-portrait.svg'}
            alt={home.founderLine.photoAlt}
            class="h-full w-full object-cover"
            width="160"
            height="160"
            loading="lazy"
          />
        </div>

        <div>
          <blockquote class="m-0 font-heading text-[clamp(1.2rem,2.5vw,1.5rem)] leading-[1.35] tracking-tight">
            <span {...editable('home.founderLine.quote')}>“{home.founderLine.quote}”</span>
          </blockquote>
          <figcaption class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.85rem] text-muted">
            <span class="uppercase tracking-[0.1em]" {...editable('home.founderLine.attribution')}>
              {home.founderLine.attribution}
            </span>
            <a href={home.founderLine.link.href} class="font-semibold text-accent no-underline hover:underline">
              {home.founderLine.link.label} →
            </a>
          </figcaption>
        </div>
      </figure>
    </div>
  </section>

  <MotionStrip image={motion.image} alt={motion.alt} editPath="motion.image" />
</Base>

<script>
  // The hero tagline types itself in on load — reserving its final height
  // first so nothing below it jumps as the text grows back in.
  const el = document.querySelector<HTMLElement>('[data-type-target]')
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (el && !reduceMotion) {
    const full = el.textContent ?? ''
    el.style.minHeight = `${el.offsetHeight}px`
    el.textContent = ''
    el.classList.add('type-cursor')

    let i = 0
    const timer = window.setInterval(() => {
      i += 1
      el.textContent = full.slice(0, i)
      if (i >= full.length) {
        window.clearInterval(timer)
        el.classList.remove('type-cursor')
        el.style.minHeight = ''
      }
    }, 38)
  }
</script>
