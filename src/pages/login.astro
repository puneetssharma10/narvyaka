---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import LoginForm from '../components/admin/LoginForm'
---

<Base title="Sign in" noindex>
  <PageHeader
    eyebrow="Narvyaka"
    heading="Sign in"
    intro="For volunteers, admins, and the site's super_admin. Everyone else can read the archive without an account."
  />

  <section class="section">
    <div class="wrap-read">
      <LoginForm client:load />
      <p class="mt-6 text-[0.9rem] text-muted">
        New here? <a href="/signup">Create a free account</a>.
      </p>
    </div>
  </section>
</Base>
